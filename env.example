from datetime import datetime
from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from bson import ObjectId
from .config import settings
from .database import orders_collection
from .models import OrderCreate, OrderOut

app = FastAPI(title="Chili DeliRico API", version="1.0.0")

origins = [origin.strip() for origin in settings.cors_origins.split(",") if origin.strip()]
app.add_middleware(
    CORSMiddleware,
    allow_origins=origins,
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

@app.get("/health")
async def health():
    return {"status": "ok", "brand": "Chili DeliRico"}

@app.post("/api/orders", response_model=OrderOut)
async def create_order(order: OrderCreate):
    if not order.items:
        raise HTTPException(status_code=400, detail="Order must include at least one item")

    calculated_total = sum(item.price_crc * item.quantity for item in order.items)
    if calculated_total != order.total_crc:
        raise HTTPException(status_code=400, detail="Order total does not match items")

    payload = order.model_dump()
    payload["created_at"] = datetime.utcnow()
    result = await orders_collection.insert_one(payload)
    payload["id"] = str(result.inserted_id)
    return payload

@app.get("/api/orders/{order_id}", response_model=OrderOut)
async def get_order(order_id: str):
    if not ObjectId.is_valid(order_id):
        raise HTTPException(status_code=400, detail="Invalid order id")
    order = await orders_collection.find_one({"_id": ObjectId(order_id)})
    if not order:
        raise HTTPException(status_code=404, detail="Order not found")
    order["id"] = str(order["_id"])
    return order
